---
import "@fontsource/kalam/400.css";
import "@fontsource/kalam/700.css";
import "../styles/notepad.css";

const tabs = [
  { id: "notes", label: "Notes" },
  { id: "vat", label: "VAT" },
  { id: "discounts", label: "Discounts" },
  { id: "compound", label: "Compound interest" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="A notepad calculator for quick percentages, discounts, VAT, and interest. Just type." />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL.replace(/\/$/, "")}/favicon.svg`} />
    <title>Quick Calc Pad</title>
  </head>
  <body>
    <main class="desk">
      <h1 class="title">Quick Calc Pad</h1>

      <nav class="tabs" role="tablist" aria-label="Sheets">
        {
          tabs.map((tab, i) => (
            <button
              class="tab"
              role="tab"
              type="button"
              data-sheet={tab.id}
              aria-selected={i === 0 ? "true" : "false"}
            >
              {tab.label}
            </button>
          ))
        }
      </nav>

      <section class="sheet" role="tabpanel">
        <p class="tips">
          Type a calculation on each line, like <em>20% off 80</em> or <em>21% of 150</em>.
          Every answer gets a name (<em>line1</em>, <em>line2</em>…) you can use on later lines,
          and a line like <em>plus 30</em> keeps going from the answer above.
        </p>

        <label class="visually-hidden" for="pad">Calculations</label>
        <div class="pad-wrap">
          <div class="gutter" id="gutter" aria-hidden="true"></div>
          <textarea
            id="pad"
            class="pad"
            spellcheck="false"
            autocomplete="off"
            autocapitalize="off"
            wrap="off"
            rows="5"
            placeholder="20% off 80"></textarea>
        </div>

        <hr class="separator" />

        <ol class="results" id="results" aria-live="polite"></ol>
      </section>
    </main>

    <script src="../scripts/app.ts"></script>
  </body>
</html>
